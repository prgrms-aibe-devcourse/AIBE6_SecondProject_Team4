# ============================================================
# application-secret.yml 작성 가이드
#
# 이 파일을 복사해서 application-secret.yml 로 이름을 바꾸고
# 아래 값들을 실제 값으로 채워주세요.
#
# application-secret.yml 은 .gitignore 에 등록되어 있으므로
# 절대 Git 에 커밋하지 마세요.
# ============================================================

# ------------------------------------------------------------
# JWT 설정
# ------------------------------------------------------------
custom:
  jwt:
    # HS256 알고리즘 기준 최소 32자 이상의 랜덤 문자열을 사용하세요.
    # 터미널에서 생성: openssl rand -base64 32
    secretKey: # 키 삽입

  accessToken:
    # Access Token 유효 시간 (초 단위)
    # 1200 = 20분 / 3600 = 1시간 / 86400 = 24시간
    expireSeconds: 1200

# ------------------------------------------------------------
# MySQL 접속 정보 (prod 프로파일에서 사용)
# ------------------------------------------------------------
db:
  mysql:
    # allowPublicKeyRetrieval=true : MySQL 8.0 기본 인증 방식(caching_sha2_password) 허용 — 없으면 연결 오류 발생
    # useSSL=false                 : 로컬 환경 SSL 비활성화 (운영 서버 배포 시 제거)
    # serverTimezone=Asia/Seoul    : 서버 시간대 설정
    url: jdbc:mysql://localhost:3306/fitmate?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root          # MySQL 사용자 이름
    password: 1234          # MySQL 비밀번호
